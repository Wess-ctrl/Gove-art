---
<footer class="footer bg-surface">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="logo">BEATRIZ <span>GONZÁLEZ DE LA VEGA</span></a>
        <p class="copyright">&copy; {new Date().getFullYear()} Beatriz González de la Vega. Todos los derechos reservados.</p>
      </div>
      
      <div class="social-links">
        <a href="#" aria-label="Instagram">Instagram</a>
        <a href="#" aria-label="X">Red Social 2</a>
        <a href="#" aria-label="X">Red Social 3</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 4rem 0;
    border-top: 1px solid var(--color-border);
  }

  .bg-surface {
    background-color: var(--color-surface);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--color-text-main);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .logo span {
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 4px;
    font-weight: 300;
  }

  .copyright {
    font-size: 0.85rem;
    margin: 0;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a {
    font-size: 0.9rem;
    color: var(--color-text-main--dark-blue);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
