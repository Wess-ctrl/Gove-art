---
<header class="header">
  <div class="container header-content">
    <div class="logo">
      <a href="/">Gove Art</a>
    </div>
    <nav class="nav">
      <ul>
        <li><a href="/about">Biografía</a></li>
        <li><a href="/work">Galería</a></li>
        <li><a href="/featured">Obras Destacadas</a></li>
        <li><a href="/contact" class="btn-primary">Encargos</a></li>
      </ul>
    </nav>
  </div>
  <div class="vignette vignette-top"></div>

</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: transparent;
    transition: all 0.4s ease;
  }

  .header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 180px; 
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.9) 0%, rgba(255, 255, 255, 0) 100%);
    opacity: 0; 
    transition: opacity 0.6s ease; 
    z-index: -1; 
    pointer-events: none; 
  }

  .header-content {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 90px;
    transition: height 0.4s ease;
  }
  .header.scrolled {
    /* background: linear-gradient(to bottom, rgba(0, 0, 0, 0.9) 0%, rgba(255, 255, 255, 0) 100%); */
    /* backdrop-filter: blur(8px); */
  }

  .header.scrolled .header-content {
    height: 60px;
  }

  .vignette-top {
    position: absolute;
    background: linear-gradient(to bottom, var(--vignette-top) 0%, transparent);
    height: 200px;
    z-index: -1;
  }

  .logo a {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: 2px;
    color: #ffffff !important;
  }

  .logo span {
    color: var(--color-accent);
    font-size: 1rem;
    letter-spacing: 4px;
    display: block;
    font-weight: 300;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav a {
    font-size: 0.9rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #ffffff;
  }

  .nav a:hover {
    color: var(--color-bg);
    border-style: none none solid;
    border-width: 0 0 2px;
    border-color: black black var(--color-accent);
    transition: border 0.4s ease;
  }

  .btn-primary {
    border: 1px solid var(--color-accent);
    padding: 0.5rem 1.5rem;
    color: #ffffff;
    border-radius: 2px;
  }

  .btn-primary:hover {
    background: var(--color-accent);
    color: var(--color-text-main--dark-blue) !important;
    border: none !important;
  }

  @media (max-width: 768px) {
    .nav {
      display: none;
    }
  }
</style>

<script>
  // Seleccionamos el header
  const header = document.querySelector('.header')!;

  // Escuchamos el evento de scroll
  window.addEventListener('scroll', () => {
    // Si bajamos más de 50 píxeles, se añade el degradado y se hace pequeño
    if (window.scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });
</script>