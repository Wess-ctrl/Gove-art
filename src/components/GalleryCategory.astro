<section id="galeria" class="gallery bg-surface">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2>Galería por Categorías</h2>
      <p>Explora el portafolio clasificado según la temática y el formato de las obras.</p>
    </div>

    <div class="categories-container animate-on-scroll">
      {categories.map((cat, index) => (
        <div class="category-item" data-cat-id={cat.id}>
          <button class="category-header" aria-expanded={index === 0 ? "true" : "false"}>
            <h3>{cat.name}</h3>
            <span class="toggle-icon"></span>
          </button>
          
          <div class="category-content" style={index === 0 ? "display: block;" : "display: none;"}>
            <p class="category-date">{cat.date}</p>
            <p class="category-desc">{cat.description}</p>
            <div class="portfolio-grid">
              {cat.images.map(img => (
                <div class={`portfolio-item-card ${img.format || 'square'}`}>
                  <img src={img.url} alt={img.alt} loading="lazy" />
                  <div class="item-overlay">
                    <span class="item-alt">{img.alt}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const categoryHeaders = document.querySelectorAll('.category-header');
    
    categoryHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        const content = header.nextElementSibling as HTMLElement;
        
        // Toggle current
        if (isExpanded) {
          header.setAttribute('aria-expanded', 'false');
          content.style.display = 'none';
        } else {
          header.setAttribute('aria-expanded', 'true');
          content.style.display = 'block';
        }

      });
    });
  });
</script>

<style>
  .bg-surface {
    background-color: var(--color-surface);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .categories-container {
    max-width: 1243px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
  }

  .category-item {
    border-bottom: 1px solid var(--color-border);
  }

  .category-header {
    width: 100%;
    background: none;
    border: none;
    padding: 1rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    color: var(--color-text-main);
    text-align: left;
    transition: var(--transition-smooth);
  }

  .category-header h3 {
    margin: 0;
    font-size: 1.8rem;
    transition: var(--transition-smooth);
  }

  .category-header:hover h3 {
    color: var(--color-accent);
  }

  .toggle-icon {
    position: relative;
    width: 20px;
    height: 20px;
  }

  .toggle-icon::before, .toggle-icon::after {
    content: '';
    position: absolute;
    background-color: var(--color-text-main);
    transition: var(--transition-smooth);
  }

  .toggle-icon::before {
    top: 9px;
    left: 0;
    width: 20px;
    height: 2px;
  }

  .toggle-icon::after {
    top: 0;
    left: 9px;
    width: 2px;
    height: 20px;
  }

  .category-header[aria-expanded="true"] .toggle-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }
  
  .category-header[aria-expanded="true"] h3 {
    color: var(--color-accent);
    padding: 0;
  }

  .category-content {
    padding-bottom: 2rem;
  }

  .category-date {
    padding: 0 0.5rem 0 0; /* top, bottom, right, left */
    color: var(--color-accent-darker);
    font-weight: bold;
    margin: 0 !important;
  }

  .category-desc {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    max-width: auto;
  }

  .portfolio-grid {
    column-count: 3;
    column-gap: 1.5rem;
  }

  .portfolio-item-card {
    break-inside: avoid; /* Evita que la tarjeta se corte entre una columna y otra */
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: var(--transition-smooth);
  }

  /* Square */
  .portfolio-item-card.square {
    grid-column: span 1;
  }

  /* Vertical */
  .portfolio-item-card.vertical {
    grid-row: span 2; 
    grid-column: span 1;
  }

  /* Horizontal */
  .portfolio-item-card.horizontal {
    grid-row: span 1;
    grid-column: span 2;
  }

  .portfolio-item-card img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    /* height: 100%; */
    /* object-fit: cover; */
    transition: transform var(--transition-smooth);
  }

  .portfolio-item-card:hover img {
    transform: scale(1.05);
  }

  .portfolio-item-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .item-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0) 100%);
    padding: 1.5rem 1rem 1rem;
    opacity: 0;
    transition: opacity var(--transition-smooth);
    pointer-events: none;
  }

  .portfolio-item-card:hover .item-overlay {
    opacity: 1;
  }

  .item-alt {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  @media (max-width: 992px) {
    .portfolio-grid {
      column-count: 2; /* 2 columnas en tablets */
    }
  }

  @media (max-width: 576px) {
    .portfolio-grid {
      column-count: 1; /* 1 columna en móviles */
    }
  }
</style>
